OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
OPENAI_USE_RESPONSES_API=true
OPENAI_REASONING_EFFORT=
LOG_LEVEL=INFO
GITHUB_TOKEN=github_pat_...
CORPUS_REPOS=saleor/saleor=saleor/,saleor/saleor-docs=docs/
# What the assistant covers, in the scope gate's prompt and its refusal.
CORPUS_NAME=Saleor
# The scope gate refuses off-topic questions before the agent runs. Off leaves
# the rule to the system prompt alone. SCOPE_MODEL wants a small, fast,
# non-reasoning model.
SCOPE_GUARD_ENABLED=true
SCOPE_MODEL=gpt-4.1-mini
MAX_STEPS=12
TURN_TIMEOUT_SECONDS=120
# Tracing: Phoenix at http://localhost:6006. Set false to run without it.
TRACING_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
# Override the built-in price table (input/cached/output[/cache_write] USD
# per 1M tokens; cache_write defaults to the input rate).
# An unpriced model shows a dash in the UI rather than a guess.
MODEL_PRICES=
